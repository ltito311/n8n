{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.js": { "maxDuration": 300, "includeFiles": "{app.js,lib/**}" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/v/:id", "destination": "/watch" }
  ]
}
