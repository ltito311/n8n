# Grok (xAI) — powers titles, summaries, chapters, action items, Ask-the-video, message drafts
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_BASE_URL=https://api.x.ai/v1

# Optional: server-side transcription with any OpenAI-compatible Whisper endpoint.
# Leave blank to use the browser's live transcript (Chrome/Edge).
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1

PORT=4747
# Public URL used in share links (set this if you expose the app via a tunnel/domain)
PUBLIC_URL=
