# Groq (console.groq.com) — one key powers everything:
# Whisper transcripts, titles, summaries, chapters, action items, Ask-the-video, message drafts
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Set to "off" to rely on the browser's live captions only
GROQ_TRANSCRIBE=on

PORT=4747
# Public URL used in share links (set this if you expose the app via a tunnel/domain)
PUBLIC_URL=
